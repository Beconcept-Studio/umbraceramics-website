<div class="div--container-small space-y-10 {% if section.settings.add_space_bottom %} space-bottom {% endif %} {% if section.settings.add_space_top %} space-top-less {% endif %}">
  {% if section.settings.title or section.settings.text %}
    <div class="grid grid-cols-12 lg:gap-8 gap-4">
      <div class="lg:col-span-6 lg:col-start-4 md:col-span-8  md:col-start-3 col-span-12 lg:space-y-10 space-y-6">
        {% if section.settings.title != empty %}
          <div class="flex flex-row">
            {% if section.settings.show_number and section.settings.number != null %}
              <div class="headline-m uppercase md:w-[100px] w-[64px]">({{ section.settings.number }}).</div>
            {% endif %}
            <div class="headline-m uppercase">
              {{ section.settings.title }}
            </div>
          </div>
        {% endif %}
        {% if section.settings.text %}
          <div class="body-l {% if section.settings.indent_content %}md:indent-[100px] indent-[64px]{% endif %}">
            {{ section.settings.text }}
          </div>
        {% endif %}
        {% if section.settings.btnlink and section.settings.btntext %}
          <a href="{{ section.settings.btnlink }}" class="btn mx-auto">{{ section.settings.btntext }}</a>
        {% endif %}
      </div>
    </div>
  {% endif %}
  {% if section.blocks.size > 0 %}
    <div class="grid grid-cols-12 lg:gap-8">
      <div class="lg:col-span-6 lg:col-start-4 md:col-span-8 md:col-start-3 col-span-12 divide-y divide-dark/8 border-y border-solid border-dark/8">
        {% for block in section.blocks %}
          <div class="grid grid-cols-8 gap-1">
            <div class="lg:col-span-3 col-span-2 py-[6px] self-center">
              <div class="label-l opacity-60">{{ block.settings.contact_label }}</div>
            </div>
            <div class="col-span-1 py-[6px] h-full self-center">
              <div class="h-full w-[1px] bg-dark/8 mx-auto"></div>
            </div>
            <div class="lg:col-span-4 col-span-5 py-[6px] self-center">
              <div class="body-l">{{ block.settings.contact_content }}</div>
            </div>
          </div>
        {%- endfor %}
      </div>
    </div>
  {% endif %}
</div>

{% render 'video-placeholder-styles' %}
{% render 'deferred-media-video-styles' %}

{% schema %}
{
  "name": "Contact grid",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Settings"
    },
    {
      "type": "checkbox",
      "id": "add_space_top",
      "label": "Add padding top",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "add_space_bottom",
      "label": "Add padding bottom",
      "default": false
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_number",
      "label": "Show number",
      "default": false
    },
    {
      "type": "number",
      "id": "number",
      "visible_if": "{{section.settings.show_number == true}}",
      "label": "Choose number"
    },
    {
      "type": "checkbox",
      "id": "indent_content",
      "label": "Indent content",
      "default": false
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "btntext",
      "label": "Button text",
      "default": "Read more"
    },
    {
      "type": "url",
      "id": "btnlink",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "contact",
      "name": "Single Contact Line",
      "settings": [
        {
          "type": "text",
          "id": "contact_label",
          "label": "Label"
        },
        {
          "type": "richtext",
          "id": "contact_content",
          "label": "Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact grid",
      "category": "Beconcept"
    }
  ]
}
{% endschema %}
