<footer class="bg-transparent w-full hidden lg:block">
  <div class="div--container h-[32px] flex items-center justify-center">
    {% if section.settings.footer_menu %}
      {% assign footermenu = section.settings.footer_menu %}
      <div class="flex items-center gap-[3px] justify-center">
        {% for link in footermenu.links -%}
          <a
            href="{{ link.url }}"
            class="body-s flex items-center gap-[3px] text-blend group{% if link.url == '#colophon-closer-desktop' %} hidden{% endif %}"
            ><span class="group-first:hidden text-[8px]">•</span><span>{{ link.title }}</span></a
          >
        {%- endfor %}
      </div>
    {% endif %}
  </div>

  <div class="colophon-footer-wrapper absolute z-20 transition-all duration-200 flex flex-col justify-end w-full">
    <div class="divide-x divide-dark/8 flex justify-center flex-wrap border-t border-solid border border-dark/10 transition-all duration-300">
      <div class="px-4 h-[30px] flex items-center justify-center text-center text-dark/60 body-s border-l border-solid border-dark/8">
        © Umbra, 2026
      </div>
      <div class="px-4 h-[30px] gap-[2px] flex items-center justify-center text-center text-dark/60 body-s">
        <span>Design: </span><a class="underline decoration-1 underline-offset-4" target="_blank" href="https://lorenzoappiani.com">Lorenzo Appiani</a>
      </div>
      <div class="px-4 h-[30px] flex gap-[2px] items-center justify-center text-center text-dark/60 body-s border-r border-solid border-dark/8">
        <span>Development: </span
        ><a
          class="underline decoration-1 underline-offset-4"
          rel="dofollow"
          target="_blank"
          href="https://beconcept.studio/?utm_source=referral&utm_medium=customer_website&utm_campaign=UmbraCeramics"
          >Beconcept</a
        >
      </div>
    </div>
  </div>
</footer>

<script src="{{ 'footer.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% schema %}
{
  "name": "Footer Block",
  "class": "section-wrapper transition-all duration-300 translate-y-0 overflow-hidden",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "link_list",
      "id": "footer_menu",
      "label": "Footer Main Menu"
    }
  ],
  "presets": [
    {
      "name": "Footer Block",
      "category": "Beconcept"
    }
  ]
}
{% endschema %}
