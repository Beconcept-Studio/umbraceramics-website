<div class="div--container-small {% if section.settings.add_space_bottom %} space-bottom {% endif %} {% if section.settings.add_space_top %} space-top-less {% endif %}">
  {% if section.settings.title or section.settings.text %}
    <div class="grid grid-cols-12 lg:gap-8 gap-4">
      <div class="lg:col-span-6 lg:col-start-4 md:col-span-8  md:col-start-3 col-span-12 lg:space-y-10 space-y-6">
        {% if section.settings.title != empty %}
          <div class="headline-l">{{ section.settings.title }}</div>
        {% else %}
          <div class="headline-l">{{ page.title }}</div>
        {% endif %}
      </div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Page Title",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Settings"
    },
    {
      "type": "checkbox",
      "id": "add_space_top",
      "label": "Add padding top",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "add_space_bottom",
      "label": "Add padding bottom",
      "default": false
    },
    {
      "type": "text",
      "id": "title",
      "label": "Alt Title",
      "info": "Show alternative title instead of main title"
    }
  ],
  "presets": [
    {
      "name": "Page Title",
      "category": "Beconcept"
    }
  ]
}
{% endschema %}
