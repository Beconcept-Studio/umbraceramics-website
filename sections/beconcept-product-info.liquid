{% liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign price = selected_variant.price | money
  assign compare_at_price = selected_variant.compare_at_price
  assign show_compare_price = false
  if compare_at_price > selected_variant.price
    assign show_compare_price = true
    assign compare_at_price = compare_at_price | money
  endif
  assign product_features = product.metafields.custom.product_features.value
%}
<div class="product-informations relative border-b border-solid border-dark/10">
  <div class="grid gap-0 lg:divide-x divide-y lg:divide-y-0 divide-dark/10 lg:grid-cols-2 lg:h-[calc(100dvh_-_var(--header-group-height))]">
    <div class="xl:px-[130px] lg:px-[100px] md:py-[64px] py-[52px] lg:py-0 flex items-center justify-center lg:h-full h-fit overflow-hidden">
      <div class="flex lg:flex-row flex-col-reverse gap-10 items-start justify-center w-full">
        <div class="caption flex lg:flex-col justify-center lg:justify-start w-full lg:w-fit lg:gap-2 gap-6 select-none z-10 shrink-0">
          {%- for image in product.images -%}
            <a
              class="pagination-item w-max cursor-pointer transition-all duration-300 py-1 block {% if forloop.first %}opacity-100 font-bold{% else %}opacity-30{% endif %}"
              data-index="{{ forloop.index0 }}"
            >
              {{ forloop.index }}-{{ forloop.length }}
            </a>
          {%- endfor -%}
        </div>
        <div class="swiper mySwiper max-w-[60%] md:!max-w-[40%] lg:!max-w-full mx-auto !overflow-visible w-full aspect-[4/5] relative">
          <div class="swiper-wrapper h-full !overflow-visible">
            {%- for image in product.images -%}
              <div class="swiper-slide flex items-center justify-center h-full w-full">
                <div class="aspect-4-5 relative overflow-hidden">
                  {{
                    image
                    | image_url: width: 1200
                    | image_tag:
                      class: 'w-full h-full object-cover object-center block',
                      loading: 'lazy',
                      alt: image.alt
                    | default: product.title
                  }}
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>

    <!-- Colonna Destra: Titolo Prodotto -->
    <div class="flex items-center justify-center xl:px-[130px] lg:px-[100px] py-[60px] lg:py-0">
      <div class="w-full lg:aspect-[9/9.5] md:px-10 px-4 lg:px-0 grid lg:block grid-cols-12 gap-x-4">
        <div class="lg:space-y-14 space-y-10 md:col-span-8 col-span-12 md:col-start-3">
          <div class="space-y-3">
            <div class="headline-l">{{ product.title }}</div>
            <div class="flex items-center gap-3 price-l">
              <div class="opacity-60">{{ price }}</div>
              {% if show_compare_price %}
                <div class="opacity-30 line-through decoration-1">{{ compare_at_price }}</div>
              {% endif %}
            </div>
          </div>

          {% if product.description != empty or product_features != empty %}
            <div class="space-y-5">
              {% if product.description != empty %}
                <div class="body-l max-w-[480px]">
                  {{ product.description }}
                </div>
              {% endif -%}
              {% if product_features != null %}
                <div class="divide-y w-full divide-dark/8 border-y border-solid border-dark/8">
                  {% for feature in product_features %}
                    {% assign parts = feature | split: '|' %}
                    <div class="grid w-full grid-cols-8 gap-1">
                      <div class="col-span-5 py-[4px] self-center">
                        <div class="label-l opacity-60">{{ parts[0] | strip }}</div>
                      </div>
                      <div class="col-span-1 py-[4px] h-full self-center">
                        <div class="h-full w-[1px] bg-dark/8 mx-auto"></div>
                      </div>
                      <div class="col-span-2 py-[4px] self-center">
                        <div class="note opacity-60">
                          {{ parts[1] | strip }}
                        </div>
                      </div>
                    </div>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          {% endif %}

          {% if product.available == false %}
            <div class="headline-s opacity-60 flex items-center gap-2">
              <span class="bg-current w-[7px] aspect-square rounded-full inline-flex"></span>
              <span>Sold out</span>
            </div>
          {% endif %}

          {%- form 'product', product, class: 'w-full space-y-2' -%}
            <input type="hidden" name="id" value="{{ selected_variant.id }}">
            <div class="flex w-full gap-4 items-stretch h-[40px]">
              {%- liquid
                assign show_quantity_input = false
                if selected_variant.inventory_management == 'shopify' and product.available and product.inventory_quantity > 1
                  assign show_quantity_input = true
                endif

                assign max_quantity = ''
                if show_quantity_input and selected_variant.inventory_policy == 'deny' and selected_variant.inventory_quantity > 0
                  assign max_quantity = selected_variant.inventory_quantity
                endif
              -%}

              {%- if show_quantity_input -%}
                <div class="flex items-center button border border-solid border-dark/16 w-[100px] shrink-0 relative">
                  <button
                    type="button"
                    class="min-w-10 w-10 h-full flex items-center justify-center opacity-60 hover:opacity-100 transition-opacity select-none cursor-pointer"
                    onclick="const inp = this.parentNode.querySelector('input[type=number]'); inp.stepDown(); inp.dispatchEvent(new Event('change'));"
                  >
                    &minus;
                  </button>
                  <input
                    type="number"
                    name="quantity"
                    value="1"
                    min="1"
                    {% if max_quantity != '' %}
                      max="{{ max_quantity }}"
                    {% endif %}
                    class="w-full h-full text-center bg-transparent border-none focus:outline-none appearance-none [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
                  >
                  <button
                    type="button"
                    class="min-w-10 w-10 h-full flex items-center justify-center opacity-60 hover:opacity-100 transition-opacity select-none cursor-pointer"
                    onclick="const inp = this.parentNode.querySelector('input[type=number]'); if(!inp.max || parseInt(inp.value) < parseInt(inp.max)) { inp.stepUp(); inp.dispatchEvent(new Event('change')); }"
                  >
                    &plus;
                  </button>
                </div>
              {%- else -%}
                <input type="hidden" name="quantity" value="1">
              {%- endif -%}

              <button
                type="submit"
                name="add"
                class="w-full h-full bg-transparent text-dark button border border-solid border-dark/16 transition-all duration-300 hover:opacity-60 disabled:opacity-30 cursor-pointer disabled:cursor-not-allowed flex items-center justify-center"
                {% unless selected_variant.available %}
                  disabled
                {% endunless %}
              >
                <span> Add to cart </span>
              </button>
            </div>
          {%- endform -%}
        </div>
      </div>
    </div>
  </div>
</div>

<script type="module">
  import { CartLinesUpdateEvent } from '@shopify/events';

  document.addEventListener('DOMContentLoaded', function () {
    // --- 1. GESTIONE SWIPER ---
    const swiperEl = document.querySelector('.mySwiper');
    if (swiperEl && typeof Swiper !== 'undefined') {
      const paginationItems = document.querySelectorAll('.pagination-item');

      // Funzione helper per calcolare i VW in Pixel
      const getHwInPx = (vw) => (window.innerHeight * vw) / 100;

      const swiper = new Swiper('.mySwiper', {
        direction: 'horizontal',
        slidesPerView: 1,
        speed: 1000,
        spaceBetween: 80, // Default in px
        mousewheel: false,
        grabCursor: false,
        on: {
          slideChange: function () {
            paginationItems.forEach((item, idx) => {
              if (idx === this.activeIndex) {
                item.classList.remove('opacity-30');
                item.classList.add('opacity-100');
              } else {
                item.classList.add('opacity-30');
                item.classList.remove('opacity-100');
              }
            });
          },
          // Ricalcola lo spaceBetween al ridimensionamento della finestra
          resize: function () {
            if (window.innerWidth >= 899) {
              // Imposta lo spazio in base al calcolo dei pixel equivalenti a 15vw
              this.params.spaceBetween = getVwInPx(15);
            } else {
              // Torna al default se sotto 899px
              this.params.spaceBetween = 80;
            }
            this.update(); // Forza l'aggiornamento del layout
          }
        },
        breakpoints: {
          899: {
            direction: 'vertical',
            // Inizializza con il calcolo dei pixel equivalenti a 15vw
            spaceBetween: (window.innerHeight * 20) / 100,
          },
          1280: {
            direction: 'vertical',
            // Inizializza con il calcolo dei pixel equivalenti a 15vw
            spaceBetween: (window.innerHeight * 35) / 100,
          },
        },
      });

      paginationItems.forEach((item) => {
        item.addEventListener('click', function () {
          const index = parseInt(this.getAttribute('data-index'), 10);
          swiper.slideTo(index);
        });
      });
    }

    // --- 2. CONTROLLO INPUT QUANTITÀ ---
    const qtyInput = document.querySelector('input[name="quantity"]');
    if (qtyInput) {
      qtyInput.addEventListener('change', function () {
        let val = parseInt(this.value, 10);
        const min = parseInt(this.min || 1, 10);
        const max = parseInt(this.max, 10);

        if (isNaN(val) || val < min) val = min;
        if (!isNaN(max) && val > max) val = max;

        this.value = val;
      });
    }

    // --- 3. ADD TO CART AJAX & ANIMAZIONE BUBBLE ---
    const productForm = document.querySelector('form[action$="/cart/add"]');

    if (productForm) {
      productForm.addEventListener('submit', function (e) {
        e.preventDefault();

        const submitButton = productForm.querySelector('button[type="submit"]');
        const originalText = submitButton.innerHTML;

        submitButton.disabled = true;
        submitButton.innerHTML = '<span>Adding...</span>';

        const formData = new FormData(productForm);
        const itemCount = Number(formData.get('quantity')) || 1;

        const cartDrawerEl = document.querySelector('beconcept-cart-drawer');
        const sectionId = cartDrawerEl ? cartDrawerEl.getAttribute('data-section-id') : null;
        if (sectionId) {
          formData.append('sections', sectionId);
          formData.append('sections_url', window.location.pathname);
        }

        const deferredEventPromise = CartLinesUpdateEvent.createPromise();
        productForm.dispatchEvent(
          new CartLinesUpdateEvent({
            action: 'add',
            context: 'product',
            lines: [
              {
                merchandiseId: formData.get('id'),
                quantity: itemCount,
              },
            ],
            promise: deferredEventPromise.promise,
          })
        );

        fetch('/cart/add.js', {
          method: 'POST',
          body: formData,
          headers: {
            'X-Requested-With': 'XMLHttpRequest',
            Accept: 'application/json',
          },
        })
          .then((response) => {
            if (!response.ok) throw new Error("Errore nell'aggiunta al carrello");
            return response.json();
          })
          .then((addResponse) => {
            // /cart/add.js returns the added line item + rendered sections, but not
            // cart-level totals, so fetch those separately.
            return fetch('/cart.js', { headers: { Accept: 'application/json' } })
              .then((response) => response.json())
              .then((cartState) => ({ addResponse, cartState }));
          })
          .then(({ addResponse, cartState }) => {
            submitButton.disabled = false;
            submitButton.innerHTML = originalText;

            // 1. Aggiorna i contatori carrello in tutta la pagina
            const cartCounters = document.querySelectorAll(
              '#cart-count, .cart-count, [data-cart-count], [data-cart-count-label]'
            );
            cartCounters.forEach((counter) => {
              counter.textContent = cartState.item_count;
            });

            // 2. Aggiorna l'interno del Drawer tramite la sezione restituita dall'add.js
            const cartDrawer = document.querySelector('beconcept-cart-drawer');
            if (cartDrawer) {
              const htmlContent =
                addResponse.sections?.[sectionId] ||
                (addResponse.sections ? Object.values(addResponse.sections)[0] : null);

              if (htmlContent) {
                cartDrawer.renderNewHTML(htmlContent);
              }

              // 3. APRI IL DRAWER
              if (typeof cartDrawer.open === 'function') {
                cartDrawer.open();
              }
            }

            deferredEventPromise.resolve({
              cart: CartLinesUpdateEvent.createCartFromAjaxResponse(cartState),
              detail: {
                items: cartState.items,
                source: 'beconcept-product-info',
                itemCount,
                didError: false,
              },
            });
          })
          .catch((error) => {
            console.error('Errore Add to Cart AJAX:', error);
            submitButton.disabled = false;
            submitButton.innerHTML = '<span>Error! Try again</span>';
            setTimeout(() => {
              submitButton.innerHTML = originalText;
            }, 2000);
            deferredEventPromise.reject(error);
          });
      });
    }
  });
</script>

{% schema %}
{
  "name": "Product Informations",
  "limit": 1,
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [
    {
      "name": "Product Informations",
      "category": "Beconcept"
    }
  ]
}
{% endschema %}
