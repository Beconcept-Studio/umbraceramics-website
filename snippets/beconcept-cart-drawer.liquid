<beconcept-cart-drawer
  id="be-cart-drawer"
  data-section-id="beconcept-cart-drawer-section"
  class="opacity-0 pointer-events-none transition-opacity duration-300 z-[9999999]"
>
  <section class="fixed inset-0 w-full h-full p-4 bg-main-bg/95 backdrop-blur-[15px] overflow-y-auto">
    <div class="min-h-full w-full flex lg:items-center justify-center relative">
      <button type="button" data-close class="cursor-pointer label-l top-0 right-0 absolute">Close</button>

      {% render 'beconcept-cart-drawer-content' %}
    </div>
  </section>
</beconcept-cart-drawer>
