{% # SRA target for /cart/change.js and /cart/clear.js AJAX requests, rendered on its own by sections/beconcept-cart-drawer-section.liquid. %}
<div id="cart-drawer-content" class="w-full max-w-[1215px] space-y-20 py-12">
  <div class="lg:space-y-5 space-y-4">
    <div class="hidden lg:grid grid-cols-12 gap-8 label-l">
      <div class="col-span-2">
        Cart (<span data-cart-count-label>{{ cart.item_count }}</span>)
      </div>
      <div class="col-span-6">Item</div>
      <div class="col-span-4">Quantity</div>
    </div>
    <div class="h-[1px] w-full block bg-dark/8"></div>

    {% if cart.empty? %}
      <div class="grid grid-cols-12 gap-8 headline-s">
        <div class="lg:col-span-2 md:col-span-3 col-span-5">
          <div class="aspect-4-5 lg:aspect-auto w-full flex items-center">
            <div class="">Your cart is empty</div>
          </div>
        </div>
      </div>
      <div class="h-[1px] w-full block bg-dark/8"></div>
    {% else %}
      <div class="max-h-[280px] overflow-y-auto lg:space-y-5 space-y-4">
        {%- for item in cart.items -%}
          {%- assign show_qty_selector = false -%}
          {%- if item.variant.available -%}
            {%- if item.variant.inventory_management == blank or item.variant.inventory_policy == 'continue' or item.variant.inventory_quantity > 1 -%}
              {%- assign show_qty_selector = true -%}
            {%- endif -%}
          {%- endif -%}

          <div class="grid grid-cols-12 gap-8 headline-s" data-item-key="{{ item.key }}">
            <!-- 1. Immagine Articolo -->
            <div class="lg:col-span-2 md:col-span-3 col-span-5">
              <a href="{{ item.url }}" class="aspect-4-5 w-full bg-white block relative overflow-hidden">
                {% if item.image %}
                  {{
                    item.image
                    | image_url: width: 300
                    | image_tag: class: 'w-full h-full object-cover', loading: 'lazy'
                  }}
                {% endif %}
              </a>
            </div>

            <!-- 2. Info Dettagli e Prezzi -->
            <div class="col-span-7 md:col-span-5 lg:col-span-6 flex flex-col h-full justify-between">
              <div class="space-y-2">
                <a href="{{ item.url }}" class="block hover:underline">{{ item.title }}</a>
                <div class="flex items-center gap-3 price-label-s">

                  <!-- Prezzo finale da pagare (es. 68) -->
                  <div class="opacity-60">{{ item.final_price | money_with_currency }}</div>

                  <!-- Se il prodotto ha un "Prezzo di confronto" a catalogo maggiore del prezzo finale -->
                  {% if item.variant.compare_at_price > item.final_price %}
                    <div class="opacity-30 line-through decoration-1">
                      {{ item.variant.compare_at_price | money_with_currency }}
                    </div>

                  <!-- Altrimenti, se c'è uno sconto applicato direttamente nel carrello -->
                  {% elsif item.original_price > item.final_price %}
                    <div class="opacity-30 line-through decoration-1">
                      {{ item.original_price | money_with_currency }}
                    </div>
                  {% endif %}

                </div>
              </div>

              <!-- Gestione mobile/tablet -->
              <div class="lg:hidden flex items-center justify-between">
                {% if show_qty_selector %}
                  <div class="flex items-center h-[40px] relative">
                    <button
                      type="button"
                      data-qty-btn="minus"
                      data-key="{{ item.key }}"
                      data-qty="{{ item.quantity | minus: 1 }}"
                      class="min-w-6 w-6 h-full flex items-center justify-center opacity-60 hover:opacity-100 transition-opacity select-none cursor-pointer"
                    >
                      &minus;
                    </button>

                    <input
                      type="number"
                      value="{{ item.quantity }}"
                      min="0"
                      readonly
                      class="w-[40px] h-full text-center bg-transparent border-none focus:outline-none appearance-none [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
                    >

                    <button
                      type="button"
                      data-qty-btn="plus"
                      data-key="{{ item.key }}"
                      data-qty="{{ item.quantity | plus: 1 }}"
                      class="min-w-6 w-6 h-full flex items-center justify-center opacity-60 hover:opacity-100 transition-opacity select-none cursor-pointer"
                    >
                      &plus;
                    </button>
                  </div>
                {% else %}
                  <div class="flex items-center h-[40px] relative opacity-60">
                    {{ item.quantity }}
                  </div>
                {% endif %}

                <button
                  type="button"
                  data-remove-btn
                  data-key="{{ item.key }}"
                  class="button button--tertiary cursor-pointer hover:opacity-60 transition-opacity button"
                >
                  Remove
                </button>
              </div>
            </div>

            <!-- 3. Selettore Quantity Dinamico Desktop -->
            <div class="hidden lg:block col-span-2">
                <div class="flex items-center h-[40px] relative">
                  <button
                    type="button"
                    data-qty-btn="minus"
                    data-key="{{ item.key }}"
                    data-qty="{{ item.quantity | minus: 1 }}"
                    class="min-w-6 w-6 h-full flex items-center justify-center select-none {% if show_qty_selector %}opacity-60 cursor-pointer hover:opacity-100 transition-opacity{% else %}opacity-0{% endif %}"
                  >
                    &minus;
                  </button>

                  <input
                    type="number"
                    value="{{ item.quantity }}"
                    min="0"
                    readonly
                    class="w-[40px] h-full text-center bg-transparent border-none focus:outline-none appearance-none [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
                  >

                  <button
                    type="button"
                    data-qty-btn="plus"
                    data-key="{{ item.key }}"
                    data-qty="{{ item.quantity | plus: 1 }}"
                    class="min-w-6 w-6 h-full flex items-center justify-center select-none {% if show_qty_selector %}opacity-60 cursor-pointer hover:opacity-100 transition-opacity{% else %}opacity-0{% endif %}"
                  >
                    &plus;
                  </button>
                </div>
            </div>

            <!-- 4. Tasto Rimuovi in AJAX -->
            <div class="hidden lg:flex col-span-2 items-start justify-end">
              <button
                type="button"
                data-remove-btn
                data-key="{{ item.key }}"
                class="button button--tertiary cursor-pointer hover:opacity-60 transition-opacity button"
              >
                Remove
              </button>
            </div>
          </div>
        {% endfor %}
      </div>
    {%- endif %}
  </div>

  <!-- Totali e Checkout -->
  <div class="space-y-8">
    <div class="lg:col-span-6 lg:col-start-4 md:col-span-8 md:col-start-3 col-span-12 divide-y divide-dark/8 border-y border-solid border-dark/8">
      <div class="grid grid-cols-12 gap-2 headline-s">
        <div class="col-span-6 py-[6px] self-center">Shipping</div>
        <div class="col-span-6 py-[6px] self-center text-right">Calculated at checkout</div>
      </div>
      <div class="grid grid-cols-12 gap-2 headline-s">
        <div class="col-span-6 py-[6px] self-center">Sub Total</div>
        <div class="col-span-6 py-[6px] self-center text-right">
          {{ cart.items_subtotal_price | money_with_currency }}
        </div>
      </div>
      <div class="grid grid-cols-12 gap-2 headline-s">
        <div class="col-span-6 py-[6px] self-center">Total</div>
        <div class="col-span-6 py-[6px] self-center text-right">{{ cart.total_price | money_with_currency }}</div>
      </div>
    </div>

    <div class="flex items-center justify-end gap-4">
      <a
        href="/checkout"
        class="cart__checkout-button button {% if cart.empty? %} opacity-30 pointer-events-none {% endif %}"
        {% if cart.empty? %}
          disabled
        {% endif %}
      >
        <span class="button-text"> Proceed to checkout </span>
      </a>
    </div>
  </div>
</div>
