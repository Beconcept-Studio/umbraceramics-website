{% liquid
  assign bubble_bg_fallback = settings.page_text_color
  assign bubble_text_fallback = settings.page_background_color
%}

<div
  ref="cartBubble"
  class="cart-bubble transition-transform duration-300"
  {% assign item_count = cart.item_count %}
  {% if item_count <= 99 %}
    data-maintain-ratio
  {% endif %}
>
  <span
    ref="cartBubbleText"
    id="cart-bubble-text"
    class="cart-bubble__text"
    >(
    <span
      class=""
      ref="cartBubbleCount"
      aria-hidden="true"
      data-testid="cart-bubble"
    >
      {%- if limit == blank or cart.item_count < limit %}
        {{- cart.item_count -}}
      {%- endif -%}
    </span>
    )
  </span>
</div>

{% stylesheet %}
  .cart-bubble {
    --cart-padding: 0.2em;
    position: relative;
    width: 20px;
    aspect-ratio: 1;
    border-radius: 50%;
    border-width: 0;
    display: flex;
    line-height: normal;
    align-items: center;
    justify-content: center;
    padding-inline: var(--cart-padding);
  }

  .cart-bubble[data-maintain-ratio] {
    aspect-ratio: 1;
  }

  .cart-bubble[data-maintain-ratio] .cart-bubble__background {
    border-radius: var(--style-border-radius-50);
  }

  .cart-bubble__background {
    position: absolute;
    inset: 0;

    border-radius: var(--style-border-radius-lg);
  }

  .cart-bubble__text {
    z-index: var(--layer-flat);
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  @keyframes cartBubblePop {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.2);
    }
    100% {
      transform: scale(1);
    }
  }

  .cart-bubble--pop {
    animation: cartBubblePop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  }
{% endstylesheet %}
